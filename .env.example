# Platapicker Environment Variables
# Copy this file to .env and fill in your values.

# Database (SQLite path — no changes needed for local use)
DATABASE_URL=sqlite:///./platapicker.db

# Discord webhooks (optional — add your webhook URLs here)
DISCORD_WEBHOOK_ESPRESSO=
DISCORD_WEBHOOK_GAMECUBE=
DISCORD_WEBHOOK_OUTDOOR=
DISCORD_WEBHOOK_HEARTBEAT=
DISCORD_WEBHOOK_ALERTS=

# Facebook Marketplace (optional)
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Frontend (if running separately)
VITE_API_URL=http://localhost:8000
