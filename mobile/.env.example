# ─── Firebase ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# ─── Cloud Functions base URL ────────────────────────────────────────────────
# After deploying functions: firebase deploy --only functions
EXPO_PUBLIC_FUNCTIONS_BASE_URL=https://us-central1-your-project-id.cloudfunctions.net

# ─── DEV ONLY — remove before shipping ──────────────────────────────────────
# In production the Claude key is a Firebase secret, never in the app bundle.
# EXPO_PUBLIC_CLAUDE_API_KEY=sk-ant-...
