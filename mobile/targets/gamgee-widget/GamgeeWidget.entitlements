<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Shared App Group — lets the widget read data written by the main app
    via NativeModules.WidgetBridge.updateWidgetData().
    The same group must be in the main app's entitlements (handled via
    app.json ios.entitlements below).
  -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.gamgee.app</string>
  </array>
</dict>
</plist>
